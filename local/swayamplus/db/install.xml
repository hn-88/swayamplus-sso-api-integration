<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/swayamplus/db" VERSION="20250901" COMMENT="XMLDB file for Moodle local/swayamplus"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_swayamplus_enrol" COMMENT="Maps Moodle enrollments to Swayam">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="swayam_enrollment_id" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_course" UNIQUE="true" FIELDS="userid, courseid"/>
        <INDEX NAME="swayam_enrollment_id" UNIQUE="false" FIELDS="swayam_enrollment_id"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_swayamplus_pushqueue" COMMENT="Failed progress/completion pushes to Swayam, pending retry with backoff">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pushtype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="progress or completion"/>
        <FIELD NAME="enrollmentid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="json-encoded request body"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lastresponsecode" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="nextattempttime" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="nextattempttime" UNIQUE="false" FIELDS="nextattempttime"/>
        <INDEX NAME="enrollmentid" UNIQUE="false" FIELDS="enrollmentid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
